generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  CRITICAL
}

model Service {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  category        String
  endpointUrl     String
  region          String
  status          ServiceStatus @default(OPERATIONAL)
  lastHeartbeatAt DateTime?
  lastLatencyMs   Int?
  lastErrorRate   Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  checks          ServiceCheck[]
  incidentLinks   IncidentService[]

  @@index([status])
  @@index([category])
  @@index([region])
  @@index([userId])
}

model ServiceCheck {
  id         String        @id @default(cuid())
  serviceId  String
  checkedAt  DateTime      @default(now())
  status     ServiceStatus
  latencyMs  Int?
  httpStatus Int?
  errorRate  Float?
  message    String?

  service    Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt])
  @@index([status])
}

model Incident {
  id         String          @id @default(cuid())
  title      String
  status     IncidentStatus  @default(INVESTIGATING)
  severity   IncidentSeverity
  startedAt  DateTime        @default(now())
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  services   IncidentService[]
  events     IncidentEvent[]

  @@index([status])
  @@index([severity])
  @@index([userId])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  timestamp  DateTime @default(now())
  severity   IncidentSeverity?
  message    String
  region     String?

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, timestamp])
}

model IncidentService {
  incidentId String
  serviceId  String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([incidentId, serviceId])
  @@index([serviceId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  services      Service[]
  incidents     Incident[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

