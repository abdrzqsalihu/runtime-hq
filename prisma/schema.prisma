generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  OUTAGE
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  CRITICAL
}

model Service {
  id              String        @id @default(cuid())
  slug            String
  name            String
  category        String
  endpointUrl     String
  region          String
  status          ServiceStatus @default(OPERATIONAL)
  lastHeartbeatAt DateTime?
  lastLatencyMs   Int?
  lastErrorRate   Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  checks          ServiceCheck[]
  incidentLinks   IncidentService[]

  @@unique([userId, slug])
  @@index([status])
  @@index([category])
  @@index([region])
  @@index([userId])
}

model ServiceCheck {
  id         String        @id @default(cuid())
  serviceId  String
  checkedAt  DateTime      @default(now())
  status     ServiceStatus
  latencyMs  Int?
  httpStatus Int?
  errorRate  Float?
  message    String?

  service    Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, checkedAt])
  @@index([status])
}

model Incident {
  id         String          @id @default(cuid())
  title      String
  status     IncidentStatus  @default(INVESTIGATING)
  severity   IncidentSeverity
  startedAt  DateTime        @default(now())
  resolvedAt DateTime?
  // true when the monitoring engine opened this incident (only these are auto-resolved on recovery)
  automatic  Boolean         @default(false)
  // Incremented each time a resolved incident is reopened; part of the notification idempotency key
  notifyCycle Int            @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  services   IncidentService[]
  events     IncidentEvent[]

  @@index([status])
  @@index([severity])
  @@index([userId])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  timestamp  DateTime @default(now())
  severity   IncidentSeverity?
  message    String
  region     String?

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, timestamp])
}

model IncidentService {
  incidentId String
  serviceId  String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([incidentId, serviceId])
  @@index([serviceId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  services      Service[]
  incidents     Incident[]
  notificationSettings NotificationSettings?
  notificationTokens   NotificationToken[]
  notificationEvents   NotificationEvent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}


enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationEventType {
  INCIDENT_OPENED
  INCIDENT_RESOLVED
  TEST
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum TelegramStatus {
  ACTIVE
  BLOCKED
  INVALID
}

enum NotificationTokenKind {
  TELEGRAM_LINK
  EMAIL_VERIFY
}

// One row per user. A channel is "configured" when the email is verified / Telegram is linked.
model NotificationSettings {
  userId              String         @id
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailAddress        String?
  emailVerifiedAt     DateTime?
  emailOnIncident     Boolean        @default(true)
  emailOnRecovery     Boolean        @default(true)

  telegramChatId      String?        @unique
  telegramDisplayName String?
  telegramLinkedAt    DateTime?
  telegramStatus      TelegramStatus @default(ACTIVE)
  telegramOnIncident  Boolean        @default(true)
  telegramOnRecovery  Boolean        @default(true)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// Short-lived single-use tokens (only the SHA-256 hash is stored)
model NotificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationTokenKind
  tokenHash String                @unique
  payload   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, kind, createdAt])
}

// Outbox: one row per notification-worthy occurrence. idempotencyKey makes enqueueing repeat-safe.
model NotificationEvent {
  id             String                @id
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentId     String?
  type           NotificationEventType
  idempotencyKey String                @unique
  payload        Json
  createdAt      DateTime              @default(now())

  deliveries     NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([incidentId])
}

// One row per (event, channel): the unit that is claimed, sent, retried and tracked.
model NotificationDelivery {
  id                String              @id @default(cuid())
  eventId           String
  event             NotificationEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  lockedUntil       DateTime?
  lastError         String?
  providerMessageId String?
  providerStatus    String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt

  @@unique([eventId, channel])
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([providerMessageId])
}
