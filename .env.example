# Copy to .env and fill in. Never commit real values.

# --- Database (PostgreSQL) ---
DATABASE_URL=
DIRECT_URL=

# --- Authentication (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: Better Auth dashboard plugin
BETTER_AUTH_API_KEY=
# Optional: social sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Scheduler ---
# Bearer token the external scheduler sends to /api/cron/check-services and /api/cron/process-notifications
CRON_SECRET=

# --- Alerts: Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string, 1-256 chars of A-Z a-z 0-9 _ -  (generate: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# --- Alerts: email via Brevo ---
BREVO_API_KEY=
# Must be a sender (or domain) verified in Brevo
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Runtime HQ
# Optional: protects POST /api/brevo/webhook (delivery/bounce events). Leave empty to disable the endpoint.
BREVO_WEBHOOK_SECRET=

# --- Monitoring behaviour (optional) ---
# Consecutive failed checks before an incident (and its alert) is opened. 1-10, default 2.
INCIDENT_FAILURE_THRESHOLD=2
